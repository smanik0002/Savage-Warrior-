# Copy this file to .env  (cp .env.example .env)  -- every value is OPTIONAL.
# Without any value the game still works: offline bots + local profile + guest mode.

# Online multiplayer server URL. Leave commented: default = same host as the page, port 3001.
# VITE_SERVER_URL=https://your-deployed-server.example.com

# Firebase (Google login + cloud profile + leaderboard)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Server side (set in the terminal that runs "npm run server"):
#   FIREBASE_PROJECT_ID=your-project-id   -> server verifies Google ID tokens
#   PORT=3001
